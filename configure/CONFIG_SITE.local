# CONFIG_SITE.local
# Any buildroot or linuxRT
CROSS_COMPILER_TARGET_ARCHS := $(filter buildroot-%-x86_64 linuxRT-x86_64,$(CROSS_COMPILER_TARGET_ARCHS))
CMAKE_VERSION = 3.12.2
# CMake is a host build tool. No cross compiler needed.
CMAKE = $(PACKAGE_TOP)/cmake/$(CMAKE_VERSION)/$(EPICS_HOST_ARCH)/bin/cmake

CMAKE_TOOLCHAIN_$(T_A) = $(wildcard $(GNU_DIR)/share/buildroot/toolchainfile.cmake)
